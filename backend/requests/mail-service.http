@baseUrl = http://localhost:8080/api/v1

###
### Receive mail
###
POST {{baseUrl}}/mails
Content-Type: application/json

{
    "messageId": "mail-001",
    "senderEmail": "sender@test.com",
    "recipientEmail": "recipient@test.com",
    "subject": "Hello",
    "plainTextBody": "This is a test email."
}

###
### Get all mails
###
GET {{baseUrl}}/mails
Accept: application/json

###
### Get mail by messageId
###
GET {{baseUrl}}/mails/mail-001
Accept: application/json

###
### Get mail attachments
###
GET {{baseUrl}}/mails/mail-001/attachments
Accept: application/json

###
### Move to processing
###
PATCH {{baseUrl}}/mails/mail-001/processing


###
### Move to processed
###
PATCH {{baseUrl}}/mails/mail-001/processed


###
### Move to failed
###
PATCH {{baseUrl}}/mails/mail-001/failed

###
### Get attachments for non-existing mail
###
GET {{baseUrl}}/mails/unknown-mail/attachments
Accept: application/json

###
### Get non-existing attachment
###
GET {{baseUrl}}/mails/mail-001/attachments/999999
Accept: application/json
